# ── Demo content system ────────────────────────────────────────────────────
# demo (default): polished fictional content renders so the design can be
#   evaluated before Savo supplies verified data (statistics, case studies,
#   testimonial layout, market presence). Always noindex.
# production: demo records are suppressed — verified data, truthful
#   non-specific wording, or honest pending slots only. Never invented facts.
# NEXT_PUBLIC_CONTENT_MODE=demo

# ── Canonical production domain ─────────────────────────────────────────────
# Every canonical URL, sitemap entry and JSON-LD @id is built on this origin,
# regardless of where the site is deployed. Testing deployments never change it.
# NEXT_PUBLIC_CANONICAL_ORIGIN=https://savotechnologies.com

# ── Indexing gate ───────────────────────────────────────────────────────────
# true ONLY on the production deployment (savotechnologies.com).
# Every other environment — local dev, Vercel test/preview — stays unset/false
# and serves noindex + robots Disallow.
# NEXT_PUBLIC_INDEXABLE=true

# Extra trusted payment-provider hostnames (comma-separated, no schemes/paths).
# PayPal, Razorpay and Stripe payment hosts are supported by default.
# Public build-time setting; rebuild after changing. Never put API keys here.
NEXT_PUBLIC_PAYMENT_LINK_HOSTS=""

# ── Local development database (homebrew PostgreSQL on this machine) ───────
DATABASE_URL="postgresql://savo:savo_local_dev@localhost:5432/savo_v7"
# Live release preflight requires explicit connection_limit + pool_timeout URL
# parameters. Choose the connection limit from an approved database budget,
# multiplied by all PM2/build workers; do not copy an arbitrary sample limit.

# Deployment origin for local dev only. Canonical URLs are NOT built from this
# (see NEXT_PUBLIC_CANONICAL_ORIGIN above).
NEXT_PUBLIC_SITE_URL="http://localhost:4312"

# Optional — Google Analytics 4. Analytics only loads when this is set.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Local-only sample — live preflight requires a private >=32-character salt.
# This also signs existing unsubscribe links. Rotation needs a compatibility plan.
ENQUIRY_IP_SALT="local-development-salt"

# Optional — sub-path hosting for the Vercel test environment
# (e.g. serving under https://savotech.vercel.app/savo.v7)
# NEXT_PUBLIC_BASE_PATH=/savo.v7

# ── Admin seed (local dev only — never commit) ─────────────────────────────
ADMIN_EMAIL="admin@savotechnologies.com"
ADMIN_PASSWORD="change-me-locally"

# ── Transactional email (SMTP) ────────────────────────────────────────
# Off by default, even if SMTP credentials are copied into this environment.
MAIL_DELIVERY_MODE=off
# Only approved live deployments: MAIL_DELIVERY_MODE=live, NODE_ENV=production,
# NEXT_PUBLIC_CONTENT_MODE=production. Preview/staging MUST remain off.
# Validate the loaded release environment: node scripts/verify-runtime-env.mjs live
# Actual DNS/provider/delivery authority still requires separate verification.
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=hello@savotechnologies.com
# MAIL_PASS=your-mailbox-password
# MAIL_FROM=Savo Technologies <hello@savotechnologies.com>
# TEAM_EMAIL=hello@savotechnologies.com
# HR_EMAIL=hr@savotechnologies.com
# HR compose requires its own mailbox; interactive sends never fall back to hello.
# MAIL_HR_USER=hr@savotechnologies.com
# MAIL_HR_PASS=your-private-hr-mailbox-password
# Composer behavior and permissions: docs/EMAIL-COMPOSE.md.

# Invoice reminders: disabled until an approved release configures the private
# job secret and a 15-minute cron runner. Stages send at/after 09:00 Asia/Kolkata.
# Activation, failure handling and isolated verification: docs/REMINDERS.md.
INVOICE_REMINDERS_ENABLED=false
INVOICE_REMINDER_SECRET=""
# Generate outside source control: openssl rand -hex 32
# Runner only accepts a loopback HTTP origin; change port for a local preview.
# INVOICE_REMINDER_BASE_URL=http://127.0.0.1:4300

# Inbound parsed-email webhook: REQUIRED if this integration is used.
# Missing configuration returns 503; unauthenticated deliveries are rejected.
# Configure the same random secret in the provider's x-webhook-secret header.
# Query-secret compatibility remains available; redact query strings in proxy logs.
# EMAIL_INBOUND_SECRET=replace-with-a-long-random-shared-secret

# ── Secret storage master key (payment gateway credentials) ───────────
# Encrypts Razorpay API/webhook secrets stored via Admin → Settings →
# Payment gateway, hashes step-up verification codes and signs step-up
# grants for that page. REQUIRED before credentials can be saved there.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored credentials unreadable (they must
# then be re-entered). Never commit; keep with production secret management.
SECRETS_MASTER_KEY=""

# ── Admin step-up verification inbox (optional) ──────────────────────
# When set, one-time codes for the payment-gateway settings page are sent
# ONLY to this address (from hello@savotechnologies.com) instead of each
# signed-in admin's own email — single-owner operations. Set it in the
# server environment, never in the panel, so a stolen session cannot
# redirect codes. Must be a mailbox you control.
# STEP_UP_EMAIL="savotechnologies@hotmail.com"

# ── Razorpay (optional environment fallback) ──────────────────────────
# Production credentials are normally managed in the admin panel (encrypted
# at rest with SECRETS_MASTER_KEY). These variables are a fallback for local
# development and scripted verification; a stored admin configuration takes
# precedence. Key ID must start with rzp_test_ or rzp_live_.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Google reCAPTCHA v2 ──────────────────────────────────────────────
# Register at https://www.google.com/recaptcha/admin (v2 checkbox).
# Client/employee sign-in requires CAPTCHA from the first attempt and fails
# closed without both keys. Admin retains its progressive failure policy.
# Public enquiry/application forms require CAPTCHA when configured.
# Never deploy Google's public test pair; use real production v2 keys.
# Partial setup fails safely. Configure BOTH at build/runtime;
# NEXT_PUBLIC keys are frozen into the browser at build.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
