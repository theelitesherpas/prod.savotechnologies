# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (enquiries, admin, managed content)
DATABASE_URL="postgresql://user:password@localhost:5432/savo_v6"

# ── Site ────────────────────────────────────────────────────────────────────
# Public site URL used for canonical/OG URLs, sitemap, JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin seed (scripts/seed.mjs only — not read by the running app) ───────
# Initial operator account. Use a long random password; it is bcrypt-hashed.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="generate-a-long-random-password"

# ── Optional ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. The analytics layer only loads when set.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Pepper for hashing enquirer IP addresses at rest (generate: openssl rand -hex 32)
ENQUIRY_IP_SALT="change-me"

# Structured log threshold: debug | info | warn | error
# LOG_LEVEL="info"
