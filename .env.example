# ── Demo content system ────────────────────────────────────────────────────
# demo (default): polished fictional content renders so the design can be
#   evaluated before Savo supplies verified data (statistics, case studies,
#   testimonial layout, market presence). Always noindex.
# production: demo records are suppressed — verified data, truthful
#   non-specific wording, or honest pending slots only. Never invented facts.
# NEXT_PUBLIC_CONTENT_MODE=demo

# ── Canonical production domain ─────────────────────────────────────────────
# Every canonical URL, sitemap entry and JSON-LD @id is built on this origin,
# regardless of where the site is deployed. Testing deployments never change it.
# NEXT_PUBLIC_CANONICAL_ORIGIN=https://savotechnologies.com

# ── Indexing gate ───────────────────────────────────────────────────────────
# true ONLY on the production deployment (savotechnologies.com).
# Every other environment — local dev, Vercel test/preview — stays unset/false
# and serves noindex + robots Disallow.
# NEXT_PUBLIC_INDEXABLE=true

# ── Local development database (homebrew PostgreSQL on this machine) ───────
DATABASE_URL="postgresql://savo:savo_local_dev@localhost:5432/savo_v6"

# Deployment origin for local dev only. Canonical URLs are NOT built from this
# (see NEXT_PUBLIC_CANONICAL_ORIGIN above).
NEXT_PUBLIC_SITE_URL="http://localhost:4311"

# Optional — Google Analytics 4. Analytics only loads when this is set.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional — pepper for hashing enquirer IP addresses at rest
ENQUIRY_IP_SALT="local-development-salt"

# Optional — sub-path hosting for the Vercel test environment
# (e.g. serving under https://savotech.vercel.app/savo.v6)
# NEXT_PUBLIC_BASE_PATH=/savo.v6

# ── Admin seed (local dev only — never commit) ─────────────────────────────
ADMIN_EMAIL="admin@savotechnologies.com"
ADMIN_PASSWORD="change-me-locally"
