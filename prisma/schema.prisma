// SAVO Technologies — data model
//
// Layers:
//   1. Leads        — ProjectEnquiry (project enquiries + phone callbacks)
//   2. Admin        — AdminUser, AdminSession, AuditLog
//   3. Content      — Service, Industry, SiteSetting (website content the
//                     admin panel manages; constants act as seed + fallback)
//
// Conventions: snake_case columns (@map), camelCase fields, cuid ids,
// explicit indexes on every foreign key and hot query path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Leads ───────────────────────────────

/// Inbound project enquiries and phone callback requests (single inbox).
model ProjectEnquiry {
  id          String   @id @default(cuid())
  name        String
  email       String?
  company     String?
  phone       String?
  projectType String   @map("project_type")
  budget      String?
  message     String
  /// Full structured form payload (careers application details, callback
  /// country, …) — rendered as its own panel in the admin inbox.
  data        Json?    @map("form_data")
  /// new | in_progress | closed | archived (app-level enum, see lib/enquiry-status.ts)
  status      String   @default("new")
  adminNotes  String?  @map("admin_notes")
  source      String   @default("homepage")
  userAgent   String?  @map("user_agent")
  /// Salted SHA-256 prefix — raw IPs are never stored (data minimisation).
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([projectType])
  @@map("project_enquiries")
}

// ─────────────────────────────── Admin ───────────────────────────────

/// Panel operators. Created via `npm run db:seed` (or an invite flow later).
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  /// bcrypt hash — plaintext never stored or logged.
  passwordHash String         @map("password_hash")
  name         String
  /// admin (full access) | editor (content + inbox, no user management)
  role         String         @default("admin")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

/// Server-side sessions. The cookie carries an opaque random token; only its
/// SHA-256 hash is stored, so a DB leak does not yield usable tokens.
/// Sessions are revocable (delete row) and expire server-side.
model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Who did what, when — append-only trail for the admin panel.
model AuditLog {
  id        String     @id @default(cuid())
  userId    String?    @map("user_id")
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// e.g. "enquiry.status", "service.update", "auth.login"
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ────────────────────────────── Content ──────────────────────────────

/// Generic website content items for every admin-managed collection
/// (insights articles, careers roles, case-study entries, hire roles, AI
/// services, agent personas). `collection` keys into
/// src/lib/content-registry.ts; `data` holds the collection-specific
/// payload validated by the registry's field schema. Constants act as
/// seed + guaranteed fallback, exactly like services/industries.
model ContentItem {
  id            String    @id @default(cuid())
  /// Registry key, e.g. "insights" | "careers" | "case-studies" | "hire" | "ai-services" | "agents"
  collection    String
  slug          String
  title         String
  data          Json
  order         Int       @default(0)
  active        Boolean   @default(true)
  /// Content lifecycle (demo content policy): draft → demo → review →
  /// verified → published. A record is production-visible ONLY at
  /// "published" — existence in PostgreSQL is never publication.
  contentStatus String    @default("draft") @map("content_status")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([collection, slug])
  @@index([collection, active, order])
  @@map("content_items")
}

/// Website services, managed in the admin panel; seeds come from
/// src/constants (which also act as the fallback when the DB is empty).
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  /// Long-form copy for the future /services/[slug] page.
  description String?
  /// Icon key from src/constants/services.ts icon set.
  icon        String   @default("system")
  order       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("services")
}

/// Website industries, same lifecycle as services.
model Industry {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("industries")
}

/// Small key-value overrides the admin panel controls (contact email,
/// phone, announcement line). Falls back to src/constants/site.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ────────────────────────────── Client portal ──────────────────────────────

/// Client accounts for the /portal dashboard (project status, payments).
/// Credentials are managed by admins; passwords are bcrypt-hashed.
model ClientUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  company      String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions ClientSession[]
  projects ClientProject[]
  invoices Invoice[]

  @@map("client_users")
}

model ClientSession {
  id        String     @id @default(cuid())
  clientId  String     @map("client_id")
  client    ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token.
  tokenHash String     @unique @map("token_hash")
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([clientId])
  @@index([expiresAt])
  @@map("client_sessions")
}

model ClientProject {
  id        String     @id @default(cuid())
  clientId  String     @map("client_id")
  client    ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Human reference, e.g. SAVO-2026-014.
  code      String     @unique
  title     String
  /// planning | in_progress | review | delivered | paused | cancelled
  status    String     @default("in_progress")
  /// 0-100 delivery progress.
  progress  Int        @default(0)
  summary   String     @default("")
  startDate DateTime?  @map("start_date")
  dueDate   DateTime?  @map("due_date")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  milestones ProjectMilestone[]
  updates    ProjectUpdate[]
  invoices   Invoice[]

  @@index([clientId])
  @@map("client_projects")
}

model ProjectMilestone {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  /// pending | in_progress | done
  status    String        @default("pending")
  dueDate   DateTime?     @map("due_date")
  order     Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_milestones")
}

/// Delivery log entries shown on the client dashboard timeline.
model ProjectUpdate {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  body      String        @default("")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_updates")
}

/// Payments — amounts stored in minor units (paise/cents) with an ISO
/// currency code; status: draft | sent | paid | overdue | cancelled.
model Invoice {
  id        String         @id @default(cuid())
  clientId  String         @map("client_id")
  client    ClientUser     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?        @map("project_id")
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  number    String         @unique
  /// Minor units (e.g. 250000 = Rs 2,500.00).
  amount    Int
  currency  String         @default("INR")
  status    String         @default("sent")
  notes     String         @default("")
  issuedAt  DateTime       @default(now()) @map("issued_at")
  dueDate   DateTime?      @map("due_date")
  paidAt    DateTime?      @map("paid_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("invoices")
}

/// First-party web analytics (privacy-friendly by design: no raw IPs or
/// user agents are stored — only a salted daily hash for rough uniques).
/// type: "pageview" | "event"; events mirror the GA4 dataLayer names.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  path        String
  eventName   String?  @map("event_name")
  referrer    String?
  device      String?
  visitorHash String?  @map("visitor_hash")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([eventName, createdAt])
  @@map("analytics_events")
}

/// Admin overrides for transactional email templates. Key = registry key
/// (e.g. "enquiryAck"); body supports {{placeholders}} rendered at send
/// time. Absent row = the tested code default is used.
model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}
