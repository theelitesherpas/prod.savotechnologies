// SAVO Technologies — data model
//
// Layers:
//   1. Leads        — ProjectEnquiry (project enquiries + phone callbacks)
//   2. Admin        — AdminUser, AdminSession, AuditLog
//   3. Content      — Service, Industry, SiteSetting (website content the
//                     admin panel manages; constants act as seed + fallback)
//
// Conventions: snake_case columns (@map), camelCase fields, cuid ids,
// explicit indexes on every foreign key and hot query path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Leads ───────────────────────────────

/// Inbound project enquiries and phone callback requests (single inbox).
model ProjectEnquiry {
  id          String   @id @default(cuid())
  name        String
  email       String?
  company     String?
  phone       String?
  projectType String   @map("project_type")
  budget      String?
  message     String
  /// Full structured form payload (careers application details, callback
  /// country, …) — rendered as its own panel in the admin inbox.
  data        Json?    @map("form_data")
  /// Career pipeline: new | shortlisted | interview_scheduled | rejected | hired | archived
  careerStatus String?  @map("career_status")
  /// Interview scheduling (career enquiries only)
  interviewDate DateTime? @map("interview_date")
  meetingLink  String?   @map("meeting_link")
  interviewer  String?   @map("interviewer")
  emailReplies EmailReply[] @relation("EmailReplies")
  /// new | in_progress | closed | archived (app-level enum, see lib/enquiry-status.ts)
  status      String   @default("new")
  adminNotes  String?  @map("admin_notes")
  source      String   @default("homepage")
  userAgent   String?  @map("user_agent")
  /// Salted SHA-256 prefix — raw IPs are never stored (data minimisation).
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([projectType])
  @@map("project_enquiries")
}

// ─────────────────────────────── Admin ───────────────────────────────

/// Panel operators. Created via `npm run db:seed` (or an invite flow later).
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  /// bcrypt hash — plaintext never stored or logged.
  passwordHash String         @map("password_hash")
  name         String
  /// admin (full access) | editor (section access via permissions)
  role         String         @default("admin")
  /// Section keys this editor may access (see lib/permissions.ts);
  /// admins bypass and always see everything.
  permissions  Json?
  /// Linked employee record — panel access granted by employee ID.
  employeeId   String?        @map("employee_id")
  employee     Employee?     @relation("PanelUserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  assignedChats ChatConversation[] @relation("ChatAssignedAgent")

  @@map("admin_users")
}

/// Server-side sessions. The cookie carries an opaque random token; only its
/// SHA-256 hash is stored, so a DB leak does not yield usable tokens.
/// Sessions are revocable (delete row) and expire server-side.
model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Who did what, when — append-only trail for the admin panel.
model AuditLog {
  id        String     @id @default(cuid())
  userId    String?    @map("user_id")
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// e.g. "enquiry.status", "service.update", "auth.login"
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ────────────────────────────── Content ──────────────────────────────

/// Generic website content items for every admin-managed collection
/// (insights articles, careers roles, case-study entries, hire roles, AI
/// services, agent personas). `collection` keys into
/// src/lib/content-registry.ts; `data` holds the collection-specific
/// payload validated by the registry's field schema. Constants act as
/// seed + guaranteed fallback, exactly like services/industries.
model ContentItem {
  id            String    @id @default(cuid())
  /// Registry key, e.g. "insights" | "careers" | "case-studies" | "hire" | "ai-services" | "agents"
  collection    String
  slug          String
  title         String
  data          Json
  order         Int       @default(0)
  active        Boolean   @default(true)
  /// Content lifecycle (demo content policy): draft → demo → review →
  /// verified → published. A record is production-visible ONLY at
  /// "published" — existence in PostgreSQL is never publication.
  contentStatus String    @default("draft") @map("content_status")
  publishedAt   DateTime? @map("published_at")
  /// Author (employee) — shown on the frontend for insights & case studies.
  authorId      String?   @map("author_id")
  author        Employee? @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName    String?   @map("author_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([collection, slug])
  @@index([collection, active, order])
  @@map("content_items")
}

/// Outbound mail log - every email the panel sends (templates and
/// custom), for the Sent folder of the admin mailbox.
model SentEmail {
  id          String   @id @default(cuid())
  toEmail     String   @map("to_email")
  toName      String?  @map("to_name")
  subject     String
  html        String   @db.Text
  text        String?  @db.Text
  /// Registry key when sent from a template, null for custom mail.
  templateKey String?  @map("template_key")
  /// Sending department mailbox: "hello" | "hr"
  dept        String   @default("hello")
  /// Admin user name who sent it.
  sentBy      String?  @map("sent_by")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("sent_emails")
}

/// Website services, managed in the admin panel; seeds come from
/// src/constants (which also act as the fallback when the DB is empty).
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  /// Long-form copy for the future /services/[slug] page.
  description String?
  /// Icon key from src/constants/services.ts icon set.
  icon        String   @default("system")
  order       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("services")
}

/// Website industries, same lifecycle as services.
model Industry {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("industries")
}

/// Small key-value overrides the admin panel controls (contact email,
/// phone, announcement line). Falls back to src/constants/site.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ────────────────────────────── Client portal ──────────────────────────────

/// Client accounts for the /portal dashboard (project status, payments).
/// Credentials are managed by admins; passwords are bcrypt-hashed.
model ClientUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  company      String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions ClientSession[]
  meetings Meeting[] @relation("MeetingClient")
  projects ClientProject[]
  invoices Invoice[]

  @@map("client_users")
}

model ClientSession {
  id        String     @id @default(cuid())
  clientId  String     @map("client_id")
  client    ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token.
  tokenHash String     @unique @map("token_hash")
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([clientId])
  @@index([expiresAt])
  @@map("client_sessions")
}

model ClientProject {
  id        String     @id @default(cuid())
  clientId  String     @map("client_id")
  client    ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Human reference, e.g. SAVO-2026-014.
  code      String     @unique
  title     String
  /// planning | in_progress | review | delivered | paused | cancelled
  status    String     @default("in_progress")
  /// 0-100 delivery progress.
  progress  Int        @default(0)
  summary   String     @default("")
  startDate DateTime?  @map("start_date")
  dueDate   DateTime?  @map("due_date")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  milestones ProjectMilestone[]
  updates    ProjectUpdate[]
  invoices   Invoice[]

  @@index([clientId])
  @@map("client_projects")
}

model ProjectMilestone {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  /// pending | in_progress | done
  status    String        @default("pending")
  dueDate   DateTime?     @map("due_date")
  order     Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_milestones")
}

/// Delivery log entries shown on the client dashboard timeline.
model ProjectUpdate {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  body      String        @default("")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_updates")
}

/// Payments — amounts stored in minor units (paise/cents) with an ISO
/// currency code; status: draft | sent | paid | overdue | cancelled.
model Invoice {
  id        String         @id @default(cuid())
  clientId  String         @map("client_id")
  client    ClientUser     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?        @map("project_id")
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  number    String         @unique
  /// Minor units (e.g. 250000 = Rs 2,500.00).
  amount    Int
  currency  String         @default("INR")
  status    String         @default("sent")
  notes     String         @default("")
  issuedAt  DateTime       @default(now()) @map("issued_at")
  dueDate   DateTime?      @map("due_date")
  paidAt    DateTime?      @map("paid_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("invoices")
}

/// First-party web analytics (privacy-friendly by design: no raw IPs or
/// user agents are stored — only a salted daily hash for rough uniques).
/// type: "pageview" | "event"; events mirror the GA4 dataLayer names.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  path        String
  eventName   String?  @map("event_name")
  referrer    String?
  device      String?
  visitorHash String?  @map("visitor_hash")
  country     String?
  countryCode String? @map("country_code")
  city        String?
  region      String?
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([eventName, createdAt])
  @@map("analytics_events")
}

/// Admin overrides for transactional email templates. Key = registry key
/// (e.g. "enquiryAck"); body supports {{placeholders}} rendered at send
/// time. Absent row = the tested code default is used.
model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

/// One-click unsubscribe list for transactional marketing mail (enquiry
/// acks, callbacks, assistant handoffs). Checked before any
/// customer-facing send; team and portal-service mail is exempt.
model MailSuppress {
  email     String   @id
  reason    String   @default("user")
  createdAt DateTime @default(now())

  @@map("mail_suppress")
}

/// Employee master records — the single source of truth for the HR
/// employee portal. Employee code (STPL00xxx) is the public identifier
/// used across emails, leaves and records.
model Employee {
  id            String          @id @default(cuid())
  employeeCode  String          @unique @map("employee_code")
  name          String
  email         String          @unique
  phone         String?
  position      String
  department    String
  /// joining | probation | active | notice | exited
  status        String          @default("joining")
  joiningDate   DateTime        @map("joining_date")
  probationEnds DateTime?       @map("probation_ends")
  lastWorkingDay DateTime?      @map("last_working_day")
  ctc           String?
  manager       String?
  location      String?
  notes         String          @default("")
  incrementDate DateTime?       @map("increment_date")
  bondExpiry    DateTime?       @map("bond_expiry")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  leaves        EmployeeLeave[]
  panelUsers    AdminUser[]     @relation("PanelUserEmployee")
  authoredItems ContentItem[]   @relation("ContentAuthor")
  sessions      EmployeeSession[] @relation("EmployeeSessions")

  @@index([status])
  @@map("employees")
}

/// Leave records — requests and their outcomes. Balance is derived
/// (credited months of service minus approved days), so approvals
/// automatically reduce availability and unused months carry forward.
model EmployeeLeave {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// privilege | sick | casual | unpaid | other
  type        String    @default("privilege")
  fromDate    DateTime  @map("from_date")
  toDate      DateTime  @map("to_date")
  days        Float
  reason      String    @default("")
  /// pending | approved | rejected | cancelled
  status      String    @default("pending")
  actedBy     String?   @map("acted_by")
  actedAt     DateTime? @map("acted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@map("employee_leaves")
}

/// Employee portal sessions - cookie-based auth for /employee-portal.
model EmployeeSession {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation("EmployeeSessions", fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_sessions")
}

/// Bug and error reports - captured automatically from error boundaries,
/// 404 pages, and user submissions. Managed in the admin Bug Reports page.
model BugReport {
  id          String   @id @default(cuid())
  /// error | 404 | api_error | user_report
  type        String
  /// Short summary line
  message     String
  /// Full error stack / details
  details     String?   @db.Text
  /// Page URL where it occurred
  url         String?
  /// Referrer
  referrer    String?
  /// Browser user agent
  userAgent   String?   @map("user_agent")
  /// Additional context (browser, screen, etc)
  context     Json?
  /// new | acknowledged | resolved | ignored
  status      String   @default("new")
  /// Admin who handled it
  handledBy   String?   @map("handled_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([createdAt])
  @@map("bug_reports")
}

/// Inbound email replies - captured via webhook (SendGrid Inbound Parse,
/// Mailgun Routes, or any email parsing service) or IMAP polling.
/// Linked to the original enquiry/employee by the sender's email address.
model EmailReply {
  id          String   @id @default(cuid())
  /// Sender's email (the person who replied)
  fromEmail   String   @map("from_email")
  fromName    String?  @map("from_name")
  /// Recipient (our mailbox: hr@ or hello@)
  toEmail     String   @map("to_email")
  subject     String
  /// Plain text body (preferred for display)
  bodyText    String?  @map("body_text") @db.Text
  /// HTML body (optional)
  bodyHtml    String?  @map("body_html") @db.Text
  /// Message-ID header for threading
  messageId   String?  @map("message_id")
  /// In-Reply-To header (links to the original message)
  inReplyTo   String?  @map("in_reply_to")
  /// Which department mailbox received it: "hr" | "hello"
  dept        String   @default("hello")
  /// Automatically matched enquiry (by sender email)
  enquiryId   String?  @map("enquiry_id")
  enquiry     ProjectEnquiry? @relation("EmailReplies", fields: [enquiryId], references: [id], onDelete: SetNull)
  /// Spam score from the parsing service (0 = clean)
  spamScore   Float?   @map("spam_score")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([fromEmail])
  @@index([enquiryId])
  @@index([createdAt])
  @@map("email_replies")
}

// ─────────────────────── Live chat (Savo Assistant + human) ───────────────────────

/// Anonymous website visitors, identified by an httpOnly cookie token
/// (hash-only storage, same pattern as admin sessions). One visitor can
/// own many conversations over time; returning visitors can resume.
model ChatVisitor {
  id          String    @id @default(cuid())
  /// SHA-256 of the cookie token — the raw token never touches the DB.
  tokenHash   String    @unique @map("token_hash")
  name        String?
  email       String?
  phone       String?
  countryCode String?   @map("country_code")
  /// Salted IP hash — rate limiting and spam review (data minimisation).
  ipHash      String?   @map("ip_hash")
  userAgent   String?   @map("user_agent")
  landingPage String?   @map("landing_page")
  blocked     Boolean   @default(false)
  blockedAt   DateTime? @map("blocked_at")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  /// Heartbeat/SSE-stream freshness — drives the online/idle indicator.
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")

  conversations ChatConversation[]

  @@index([lastSeenAt])
  @@map("chat_visitors")
}

/// One continuous thread: AI conversation + qualification + human chat.
/// AI→human handoff never creates a second conversation.
model ChatConversation {
  id        String  @id @default(cuid())
  /// Public, URL-safe token used by the visitor API (never expose the cuid).
  publicToken String @unique @map("public_token")
  visitorId String  @map("visitor_id")
  visitor   ChatVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  /// ai_only | pre_chat | waiting_for_agent | active | waiting_follow_up |
  /// visitor_left | closed | spam  (server-side transitions only)
  status    String  @default("ai_only")
  /// ai | human — when human, Savo AI stays silent unless handed back.
  mode      String  @default("ai")
  channel   String  @default("website")
  source    String  @default("savo_assistant")

  // ── Qualification (pre-chat flow) ──
  service    String?   // e.g. "Mobile application"
  stage      String?   // e.g. "Planning requirements"
  requirement String?  @db.Text // free text
  timeline   String?   // e.g. "Within 1–3 months"
  budget     String?   // e.g. "$10k–25k" | "Prefer to discuss"

  // ── Lead snapshot at capture time ──
  leadName       String?
  leadEmail      String?
  leadPhone      String?
  leadCountry    String?      @map("lead_country")
  /// new | qualified | contacted | meeting | proposal | negotiation | won | lost | n/a
  leadStatus     String @default("new") @map("lead_status")
  /// low | normal | high
  priority       String @default("normal")
  /// Internal AI-generated requirement digest (never shown to visitors).
  aiSummary      String? @db.Text @map("ai_summary")

  /// Page context: { landingPage, currentPage, referrer, utm } — JSON.
  context    Json?

  assignedId String? @map("assigned_id")
  assigned   AdminUser? @relation("ChatAssignedAgent", fields: [assignedId], references: [id], onDelete: SetNull)

  humanRequestedAt DateTime? @map("human_requested_at")
  acceptedAt       DateTime? @map("accepted_at")
  firstResponseAt  DateTime? @map("first_response_at")
  followUpAt       DateTime? @map("follow_up_at")
  closedAt         DateTime? @map("closed_at")

  /// Unread counters: messages waiting for the other side to read.
  unreadForAgent  Int @default(0) @map("unread_for_agent")
  unreadForVisitor Int @default(0) @map("unread_for_visitor")

  lastMessageAt DateTime @default(now()) @map("last_message_at")
  /// Flattened preview of the newest message for the inbox list.
  lastMessagePreview String? @map("last_message_preview")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]
  events   ConversationEvent[]
  tags     ConversationTag[]

  @@index([status])
  @@index([assignedId])
  @@index([visitorId])
  @@index([lastMessageAt])
  @@index([leadStatus])
  @@map("chat_conversations")
}

/// Every line in a conversation thread, typed by anyone or anything.
model ChatMessage {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// visitor | ai | agent | system | internal_note
  type           String
  /// Sender agent (admin user) for agent/internal messages.
  agentId        String? @map("agent_id")
  /// Display-name snapshot, e.g. "Priya — Savo" (survives agent deletion).
  senderName     String? @map("sender_name")
  body           String @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Append-only audit/status trail: handoff, accept, transfer, timeouts…
model ConversationEvent {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// e.g. human_requested | agent_notified | agent_accepted | assigned |
  /// transferred | timeout | visitor_left | closed | reopened | returned_to_ai
  type           String
  actorId        String? @map("actor_id")
  actorName      String? @map("actor_name")
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_conversation_events")
}

/// Configurable conversation tags (Website, Mobile App, High Priority…).
model ChatTag {
  id        String @id @default(cuid())
  label     String @unique
  createdAt DateTime @default(now()) @map("created_at")

  conversations ConversationTag[]
  @@map("chat_tags")
}

model ConversationTag {
  conversationId String @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String @map("tag_id")
  tag            ChatTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("chat_conversation_tags")
}

/// Per-admin live-chat presence. One row per agent, heartbeated.
model AgentPresence {
  /// AdminUser id.
  userId     String @id
  /// online | busy | away | offline (manual override or heartbeat expiry)
  status     String @default("offline")
  /// Manual (true) until the agent switches back or disconnects.
  manual     Boolean @default(false)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("agent_presence")
}

/// Live-chat runtime configuration (business hours, budgets, quick replies).
model ChatSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_settings")
}

// ─────────────────────── Client Meeting Scheduling ───────────────────────

/// Meeting requests created by admins, sent to clients via secure links.
model Meeting {
  id            String   @id @default(cuid())
  /// Human reference, e.g. MTG-2026-00421.
  reference     String   @unique
  /// SHA-256 of the public scheduling token.
  tokenHash     String   @unique @map("token_hash")
  /// Raw token (admin-only visibility for link sharing; public API never exposes it).
  tokenPlain    String   @default("") @map("token_plain")
  /// Link expiration; null = never expires.
  expiresAt     DateTime? @map("expires_at")

  // ── Client info (snapshot at creation, may link to portal user) ──
  clientId      String?  @map("client_id")
  client        ClientUser? @relation("MeetingClient", fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String   @map("client_name")
  clientCompany String   @default("") @map("client_company")
  clientPhone   String?  @map("client_phone")
  clientEmail   String?  @map("client_email")
  clientRole    String?  @map("client_role")

  // ── Meeting details ──
  title         String
  agenda        String   @default("")
  /// in_person | video | phone | office_visit | client_office | custom
  meetingType   String   @default("in_person") @map("meeting_type")
  /// Minutes: 15 | 30 | 45 | 60 | 90 | custom value
  durationMin   Int      @default(60) @map("duration_min")
  /// savo_office | client_office | google_meet | zoom | teams | phone | custom
  locationType  String   @default("savo_office") @map("location_type")
  locationAddress String? @map("location_address")
  meetingUrl    String?  @map("meeting_url")
  notes         String?  @map("notes")

  // ── Admin-defined availability ──
  /// JSON array of ISO dates the admin offered: ["2026-10-02","2026-10-03"]
  availableDates Json?    @map("available_dates")
  /// e.g. "10:00" and "18:00"
  availableFrom String   @default("10:00") @map("available_from")
  availableTo   String   @default("18:00") @map("available_to")
  /// Allow client to suggest a date outside the offered ones.
  allowSuggest  Boolean  @default(true) @map("allow_suggest")
  /// Auto-confirm when client picks a predefined slot.
  autoConfirm   Boolean  @default(false) @map("auto_confirm")

  // ── Client response (filled when client submits) ──
  /// ISO datetime string in the meeting timezone
  preferredDate String?  @map("preferred_date")
  preferredTime String?  @map("preferred_time")
  altDate       String?  @map("alt_date")
  altTime       String?  @map("alt_time")
  locationPreference String? @map("location_preference")
  clientAddress String?  @map("client_address")
  attendeeCount Int      @default(1) @map("attendee_count")
  clientNotes   String?  @map("client_notes")
  specialReqs   String?  @map("special_reqs")

  // ── Final confirmed slot (set on confirm, may differ from preferred) ──
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedDate String?  @map("confirmed_date")
  confirmedTime String?  @map("confirmed_time")

  // ── Status & assignment ──
  /// draft | awaiting_client | availability_received | confirmed |
  /// reschedule_requested | completed | cancelled | expired
  status        String   @default("draft")
  assignedTo    String?  @map("assigned_to")
  /// When the admin last opened this meeting (marks availability as read).
  seenAt        DateTime? @map("seen_at")
  /// Soft delete timestamp — meeting moved to trash, not permanently deleted.
  deletedAt     DateTime? @map("deleted_at")
  internalNotes String?  @map("internal_notes")

  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attendees     MeetingAttendee[]
  activity      MeetingActivity[]
  reschedules   MeetingReschedule[]

  @@index([status])
  @@index([clientId])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([confirmedAt])
  @@map("meetings")
}

/// Additional attendees the client adds to their response.
model MeetingAttendee {
  id         String  @id @default(cuid())
  meetingId  String  @map("meeting_id")
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  role       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([meetingId])
  @@map("meeting_attendees")
}

/// Full audit trail: created, sent, opened, responded, confirmed, etc.
model MeetingActivity {
  id         String   @id @default(cuid())
  meetingId  String   @map("meeting_id")
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// created | invitation_sent | invitation_opened | availability_submitted |
  /// meeting_confirmed | confirmation_email_sent | reschedule_requested |
  /// meeting_rescheduled | meeting_completed | meeting_cancelled | link_regenerated
  type       String
  actorName  String?  @map("actor_name")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([meetingId, createdAt])
  @@map("meeting_activity")
}

/// Reschedule history — never overwrite, always append.
model MeetingReschedule {
  id            String   @id @default(cuid())
  meetingId     String   @map("meeting_id")
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Previous slot
  previousDate  String?  @map("previous_date")
  previousTime  String?  @map("previous_time")
  /// New slot
  newDate       String   @map("new_date")
  newTime       String   @map("new_time")
  /// admin | client
  requestedBy   String   @map("requested_by")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([meetingId])
  @@map("meeting_reschedules")
}
